import { APPLICATION_DATABASE_OPTIONS } from "../lib/database-options.mjs";
import fs from 'node:fs/promises';import dotenv from 'dotenv';import {Pool} from 'pg';import {randomUUID} from 'node:crypto';import assert from 'node:assert/strict';
const env=dotenv.parse(await fs.readFile('.env'));const uri=new URL(env.DATABASE_URL);uri.port='6543';for(const key of ['sslmode','sslrootcert','sslcert','sslkey'])uri.searchParams.delete(key);
const db=new Pool({options: APPLICATION_DATABASE_OPTIONS,connectionString:uri.toString(),ssl:{rejectUnauthorized:true,ca:await fs.readFile('config/supabase-ca.crt','utf8')},max:1});const base='https://dreamforge.vercel.app';const testedModels=(process.env.MODEL_SMOKE_IDS || 'deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash').split(',');const projectId='vm-600ebc5f8da84689b84b6f2d34feaf6b';
try {
 const choices=await (await fetch(base+'/api/models')).json();for(const model of testedModels)assert.ok(choices.models.some((m:any)=>m.id===model));
 const bad=await fetch(base+'/api/chat',{method:'POST',headers:{Origin:base,'Content-Type':'application/json'},body:JSON.stringify({model:'unapproved/model'})});assert.equal(bad.status,400);console.log('PASS server rejects unapproved model IDs');
 for(const model of testedModels){
  const conversationId=randomUUID();const summary={id:conversationId,title:'Temporary model smoke test',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
  await db.query('insert into conversations(vm_id,id,messages) values($1,$2,$3)',[projectId,conversationId,'[]']);await db.query("update projects set metadata=jsonb_set(metadata,'{conversations}',metadata->'conversations'||$2::jsonb) where vm_id=$1",[projectId,JSON.stringify([summary])]);
  try{
   const started=performance.now();const r=await fetch(base+'/api/chat',{method:'POST',headers:{Origin:base,'Content-Type':'application/json'},body:JSON.stringify({model,projectId,conversationId,messages:[{id:randomUUID(),role:'user',parts:[{type:'text',text:'Read app/page.tsx once using the file-read tool, then describe the page in one short sentence. Do not modify any files or use other tools.'}]}]})});assert.equal(r.status,200);console.log('First response arrived in',Math.round(performance.now()-started),'ms');const stream=await r.text();assert.ok(!stream.includes('"type":"error"'),stream.slice(-1000));
   const {rows}=await db.query('select messages from conversations where vm_id=$1 and id=$2',[projectId,conversationId]);const assistant=rows[0].messages.filter((m:any)=>m.role==='assistant');assert.ok(assistant.some((m:any)=>m.parts.some((p:any)=>p.type==='tool-readFileTool')),'Expected file-read tool');assert.ok(assistant.some((m:any)=>m.parts.some((p:any)=>p.type==='text'&&p.text.trim())),'Expected written answer');console.log('PASS real tool call and written answer:',model);
  }finally{await db.query('delete from conversations where vm_id=$1 and id=$2',[projectId,conversationId]);await db.query("update projects set metadata=jsonb_set(metadata,'{conversations}',(select coalesce(jsonb_agg(c),'[]'::jsonb) from jsonb_array_elements(metadata->'conversations') c where c->>'id'<>$2)) where vm_id=$1",[projectId,conversationId]);}
 }
}finally{await db.end();}
