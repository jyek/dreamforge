RUNTIME_API_KEY=
# Prepared memory snapshot; required for blank projects in Vercel Production.
# Build with npm run bootstrap; validate with npm run runtime:check-starter.
RUNTIME_BASE_SNAPSHOT=
# Freestyle credentials are only used by the one-time migration script.
# Server-only settings. Keep real credentials in local/Vercel environment variables.
FREESTYLE_API_KEY=
FREESTYLE_BASE_URL=https://api.freestyle.sh
FREESTYLE_DOMAIN_SUFFIX=style.dev
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=cohere/north-mini-code:free
LLM_MAX_OUTPUT_TOKENS=8192
PROJECT_STORAGE=supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
STUDENT_LOGIN_ENABLED=false
SAFETY_ENABLED=true
STUDENT_AI_PROVIDER_APPROVED=false
STUDENT_MODERATION_URL=
STUDENT_MODERATION_KEY=
STATIC_PUBLISH_URL=
STATIC_PUBLISH_TOKEN=
CRON_SECRET=
# Teacher/child accounts. See docs/database-schema.md for current setup and cutover.
DREAMFORGE_AUTH_ENABLED=false
DREAMFORGE_SITE_URL=https://dreamforge2.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
# Only enable checkout after approving packages and verifying Stripe live mode.
DREAMFORGE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Apply the current migrations in supabase/migrations before enabling the workspace.
# A school-controlled Chromium service exposing CDP. Server-only; never place in a project.
# Without this service, compilation may pass but rendering/buttons remain unverified.
VERIFICATION_BROWSER_WS=
# Alternative: semantic moderation through the approved OpenRouter route (ZDR/no collection).
STUDENT_MODERATION_PROVIDER=
# Alternative to VERIFICATION_BROWSER_WS: bundled Chromium inside the server function.
VERIFICATION_BROWSER_BUILTIN=false

# Proposal only: back up, resolve usage holds, apply 202610280000_prepaid_credit.sql
# and approve the conversion/rate card before enabling. Do not enable against the old schema.
DREAMFORGE_PREPAID_BILLING_ENABLED=false
